# Copy to .env and fill in.

# Shop WhatsApp number in international format (country code, no + or spaces).
WHATSAPP_NUMBER=254712345678
# Lets customers type local numbers like 0712 345 678.
DEFAULT_COUNTRY_CODE=254

# Password for the order dashboard at /admin.
ADMIN_PASSWORD=change-me-to-something-long

STORE_NAME=Annie's Shoes World
CURRENCY=USD
LOCALE=en-US
PORT=3000

# Public URL of the site (used in WhatsApp tracking links). Leave blank to use the request host.
PUBLIC_URL=
# Set to true when served over HTTPS.
COOKIE_SECURE=false

# --- Optional: WhatsApp Business Cloud API ---
# Enables automatic replies when buyers message an order number, and automatic status notifications.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
