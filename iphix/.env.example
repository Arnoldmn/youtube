# ---- Store ----
PORT=3000
# Public URL of the site (used in WhatsApp messages, receipt and tracking links)
BASE_URL=http://localhost:3000
STORE_NAME=IPHIX COMMUNICATIONS
STORE_ADDRESS=Shop location, City
# Business WhatsApp number in international format, digits only (orders are sent here)
WHATSAPP_NUMBER=254702222272
# Country code used to normalise local phone numbers like 0712345678
DEFAULT_COUNTRY_CODE=254
CURRENCY=KES

# ---- Pricing ----
DELIVERY_FEE=300
FREE_DELIVERY_OVER=5000
# Quantity at which wholesale prices kick in
WHOLESALE_MIN_QTY=10

# ---- Affiliate / referral programme ----
# % of each referred sale paid to the promoter (credited once the order is delivered)
COMMISSION_PCT=5
# % discount a referred customer gets on their first order
REFERRAL_DISCOUNT_PCT=3
# Minimum balance before a promoter can request a payout
MIN_PAYOUT=500

# ---- Security ----
# Long random string. Keep it secret and stable (changing it logs everyone out and breaks old receipt links).
SESSION_SECRET=
# First admin account (created on first start if no admin exists)
ADMIN_EMAIL=admin@iphix.local
ADMIN_PASSWORD=ChangeMe123!
DB_FILE=./data/iphix.db

# ---- M-Pesa ----
# Manual Paybill shown at checkout and on receipts (works without any API keys)
MPESA_PAYBILL=529914
MPESA_PAYBILL_ACCOUNT=638804
MPESA_PAYBILL_NAME=KB M-Collection General Merchants (Kingdom Bank)

# STK push ("enter your M-Pesa PIN" prompt on the customer's phone) via Safaricom Daraja.
# Requires Daraja credentials issued for the shortcode below (sandbox: shortcode 174379 + the sandbox passkey).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till; then set MPESA_PARTY_B to the till number)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
# Leave empty to use the order number as the account reference, or set a fixed account (e.g. 638804)
MPESA_ACCOUNT_REFERENCE=
# Optional override; defaults to BASE_URL + a secret callback path. Must be public HTTPS.
MPESA_CALLBACK_URL=

# ---- Optional: WhatsApp Cloud API (automatic messages + "TRACK" auto-replies) ----
# Without these, the site uses wa.me click-to-chat links (works out of the box).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_API_VERSION=v21.0
