# ---------------------------------------------------------------------------
# Lingua Ops Admin Portal — environment configuration
# Copy to `.env` and adjust. Every value has a sensible development default.
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development

# Port the Node.js server listens on (serves the API and, in production, the React app)
PORT=4000

# Secret used to sign login tokens. REQUIRED in production — use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me

# How long a login lasts
SESSION_DAYS=7

# Where the SQLite database and uploaded files are stored (relative to this folder or absolute)
DATABASE_PATH=./data/portal.db
UPLOAD_DIR=./data/uploads

# First admin account, created automatically when the database is empty.
# In production ADMIN_PASSWORD must be set (min. 10 characters).
ADMIN_NAME=Alex Rivera
ADMIN_EMAIL=admin@linguaops.local
ADMIN_PASSWORD=admin12345

# Load sample employees, jobs and vendor applications on first start (true/false).
# Defaults to true in development and false in production.
SEED_DEMO=true

# Session cookie "Secure" flag: auto (default) = Secure whenever the request arrived over HTTPS.
# Force with true/false if needed.
# COOKIE_SECURE=auto

# Set when running behind a reverse proxy / load balancer (nginx, Render, Railway, Fly…)
# so secure cookies and rate limiting see the real client.
# TRUST_PROXY=1

# Maximum upload size per file, in megabytes
MAX_UPLOAD_MB=25
